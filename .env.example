# LLM access — OpenRouter.
OPENROUTER_API_KEY=

# Models (OpenRouter-style ids; these are the defaults if left unset).
PLAN_MODEL=anthropic/claude-sonnet-5.5
ASSESS_MODEL=anthropic/claude-haiku-5.5
SELECT_MODEL=anthropic/claude-sonnet-5.5

MAX_RUN_USD=2              # optional: hard cost cap per run in USD (0 = no cap)
YOUTUBE_API_KEY=          # optional: official Data API for search + details
MONGODB_URI=              # optional: persist runs + shared cache to MongoDB Atlas (free tier is fine)
MONGODB_DB=curriculum

# Eval judges (used by `curriculum eval` — a different family from the curator). These two values
# reproduce the committed round-2 verdicts in evals/results/; unset, the code falls back to the
# round-1 judges (openai/gpt-5.6-terra / -luna), which were much stricter (see EVAL.md).
JUDGE_MODEL=google/gemini-3.1-pro-preview
FAITH_MODEL=google/gemini-3.7-flash

# Optional transcript fallbacks, tried only when YouTube refuses the direct caption request (DECISIONS.md 2.4).
SUPADATA_API_KEY=         # hosted captions (supadata.ai); existing captions only
SUPADATA_MAX_CREDITS=     # cap on Supadata credits per process (default: the plan's remaining credits minus 5)
GEMINI_MAX_USD=5          # last resort: a Gemini model transcribes the video itself, THROUGH THE SAME
                          # OpenRouter key as every other call; this is its hard spend cap (0/unset = off)
GEMINI_TRANSCRIBE_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=           # optional very last backoff, used ONLY if the OpenRouter route fails (e.g. a video
                          # too long for full-resolution context): the same model on Google's API at low media
                          # resolution, billed to this key, charged against the same GEMINI_MAX_USD cap

CURRICULUM_CACHE=         # optional: directory for the search/details/transcript cache (default .cache)
